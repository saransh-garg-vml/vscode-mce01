{
	"name": "mced",
	"displayName": "MCE Download",
	"description": "Connect VS Code directly to your Marketing Cloud Account, download your content, data extensions, journeys and automations",
	"version": "1.0.1",
	"publisher": "saransh-garg-vml",
	"author": {
		"name": "Saransh Garg"
	},
	"engines": {
		"vscode": "^1.54.0"
	},
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"ampscript",
		"amp",
		"salesforce",
		"marketing cloud",
		"salesforce marketing cloud",
		"exacttarget",
		"sfmc",
		"mc",
		"content builder",
		"mced"
	],
	"main": "./out/src/extension",
	"scripts": {
		"vscode:prepublish": "npm run compile && npm run connectionmanager",
		"connectionmanager": "cd ./src/connection-manager && npm run build",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint . --ext .ts --fix"
	},
	"activationEvents": [
		"onCommand:mced.open",
		"onFileSystem:mced",
		"onLanguage:AMPscript",
		"onView:mced.dataExtensionInsights"
	],
	"contributes": {
		"languages": [
			{
				"id": "AMPscript",
				"aliases": [
					"AMPscript",
					"ampscript"
				],
				"extensions": [
					".amp",
					".ampscript"
				],
				"configuration": "./syntaxes/language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "AMPscript",
				"scopeName": "source.amp",
				"path": "./syntaxes/ampscript.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "AMPscript",
				"path": "./syntaxes/snippets.json"
			}
		],
		"commands": [
			{
				"command": "mced.open",
				"title": "Connection Manager",
				"category": "MCED"
			},
			{
				"command": "mced.dataextension.filter",
				"title": "Filter a dataextension",
				"category": "MCED",
				"icon": {
					"light": "images/filter.icon.svg",
					"dark": "images/filter.icon.svg"
				}
			},
			{
				"command": "mced.query.run",
				"title": "Run SQL Query",
				"category": "MCED",
				"icon": {
					"light": "images/run.icon.svg",
					"dark": "images/run.icon.svg"
				}
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "mced.dataextension.filter",
					"when": "resourceExtname == .csv && resourceScheme == mced"
				},
				{
					"command": "mced.query.run",
					"when": "resourceExtname == .sql && resourceScheme == mced"
				}
			],
			"editor/title": [
				{
					"when": "resourceExtname == .csv && resourceScheme == mced",
					"command": "mced.dataextension.filter",
					"group": "navigation"
				},
				{
					"when": "resourceExtname == .sql && resourceScheme == mced",
					"command": "mced.query.run",
					"group": "navigation"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "mcedDataExtensions",
					"title": "MCED Data Extensions",
					"icon": "images/logo.png"
				}
			]
		},
		"views": {
			"mcedDataExtensions": [
				{
					"id": "mced.dataExtensionInsights",
					"name": "Data Extension Insights",
					"type": "webview",
					"icon": "images/logo.png"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "explorer",
				"contents": "Open MCED Connection Manager and connect directly to your Salesforce Marketing Cloud account \n[Connect to SFMC](command:mced.open)",
				"when": "true"
			}
		],
		"configuration": {
			"title": "MCED Configuration",
			"properties": {
				"mced.connections": {
					"title": "A list of MCED connections",
					"description": "Use the Settings UI to edit the list of connections. Run command 'MCED: Connection Manager'",
					"markdownDescription": "Use the Settings UI to edit configurations. Run command 'MCED: Connection Manager'",
					"type": "array",
					"items": "object",
					"default": []
				},
				"mced.notifications": {
					"title": "Notification paramters",
					"description": "Stores MCED notification preferences",
					"markdownDescription": "Stores MCED notification preferences",
					"type": "object",
					"default": {
						"hasOpenedConnectionManager": false,
						"hasConnectedToMC": false,
						"dontShowConnectionManagerAlert": false,
						"hasShownChangelog": false
					}
				}
			}
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/saransh-garg-vml/vscode-mce01.git"
	},
	"icon": "images/logo.png",
	"devDependencies": {
		"@types/node": "^14.14.35",
		"@types/papaparse": "^5.2.5",
		"@types/vscode": "^1.54.0",
		"@types/xml2js": "^0.4.8",
		"@typescript-eslint/eslint-plugin": "^4.19.0",
		"@typescript-eslint/parser": "^4.19.0",
		"@vscode/vsce": "^4.0.0",
		"eslint": "^7.22.0",
		"typescript": "^4.2.3"
	},
	"dependencies": {
		"axios": "^0.27.2",
		"jsep": "^0.4.0",
		"papaparse": "^5.3.0",
		"xml2js": "^0.4.23"
	}
}
